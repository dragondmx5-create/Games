+[[nodiscard]] bool switch_to_sdl2d_fallback(
+    AppState& state,
+    const std::string_view phase,
+    const std::string& vulkan_error,
+    std::string& error
+) {
+  release_renderer_window(state);
+  std::string fallback_error;
+  if (
+      !create_application_window(
+          state,
+          RendererBackend::sdl2d,
+          fallback_error
+      ) ||
+      !initialize_sdl2d_renderer(state, fallback_error)
+  ) {
+    release_renderer_window(state);
+    error =
+        "Vulkan " + std::string(phase) + " failed: " +
+        vulkan_error + "; SDL2D fallback failed: " +
+        fallback_error;
+    return false;
+  }
+  error.clear();
+  const std::string notice =
+      "[SYSTEM] Vulkan fallback (" + std::string(phase) +
+      "): " + vulkan_error;
+  undral::ui::push_chat_line(state.ui, notice);
+  SDL_Log("%s", notice.c_str());
+  return true;
+}
